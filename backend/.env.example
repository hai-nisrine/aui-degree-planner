# Copy this file to .env and fill in your own values. Never commit .env.

# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# PostgreSQL (either set DATABASE_URL, or the individual PG* values below)
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/aui_degree_planner
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_database_password
PGDATABASE=aui_degree_planner

# Authentication
# Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d
COOKIE_NAME=auth_token

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key
